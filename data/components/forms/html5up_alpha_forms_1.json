{
  "html": "<form action=\"#\" method=\"post\">\n<div class=\"row gtr-uniform gtr-50\">\n<div class=\"col-6 col-12-mobilep\">\n<input id=\"name\" name=\"name\" placeholder=\"Name\" type=\"text\" value=\"\"/>\n</div>\n<div class=\"col-6 col-12-mobilep\">\n<input id=\"email\" name=\"email\" placeholder=\"Email\" type=\"email\" value=\"\"/>\n</div>\n<div class=\"col-12\">\n<select id=\"category\" name=\"category\">\n<option value=\"\">- Category -</option>\n<option value=\"1\">Manufacturing</option>\n<option value=\"1\">Shipping</option>\n<option value=\"1\">Administration</option>\n<option value=\"1\">Human Resources</option>\n</select>\n</div>\n<div class=\"col-4 col-12-narrower\">\n<input checked=\"\" id=\"priority-low\" name=\"priority\" type=\"radio\"/>\n<label for=\"priority-low\">Low Priority</label>\n</div>\n<div class=\"col-4 col-12-narrower\">\n<input id=\"priority-normal\" name=\"priority\" type=\"radio\"/>\n<label for=\"priority-normal\">Normal Priority</label>\n</div>\n<div class=\"col-4 col-12-narrower\">\n<input id=\"priority-high\" name=\"priority\" type=\"radio\"/>\n<label for=\"priority-high\">High Priority</label>\n</div>\n<div class=\"col-6 col-12-narrower\">\n<input id=\"copy\" name=\"copy\" type=\"checkbox\"/>\n<label for=\"copy\">Email me a copy of this message</label>\n</div>\n<div class=\"col-6 col-12-narrower\">\n<input checked=\"\" id=\"human\" name=\"human\" type=\"checkbox\"/>\n<label for=\"human\">I am a human and not a robot</label>\n</div>\n<div class=\"col-12\">\n<textarea id=\"message\" name=\"message\" placeholder=\"Enter your message\" rows=\"6\"></textarea>\n</div>\n<div class=\"col-12\">\n<ul class=\"actions\">\n<li><input type=\"submit\" value=\"Send Message\"/></li>\n<li><input class=\"alt\" type=\"reset\" value=\"Reset\"/></li>\n</ul>\n</div>\n</div>\n</form>",
