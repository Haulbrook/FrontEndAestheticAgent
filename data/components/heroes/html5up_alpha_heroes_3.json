  "html": "<div id=\"page-wrapper\">\n<!-- Header -->\n<header id=\"header\">\n<h1><a href=\"index.html\">Alpha</a> by HTML5 UP</h1>\n<nav id=\"nav\">\n<ul>\n<li><a href=\"index.html\">Home</a></li>\n<li>\n<a class=\"icon fa-angle-down\" href=\"#\">Layouts</a>\n<ul>\n<li><a href=\"generic.html\">Generic</a></li>\n<li><a href=\"contact.html\">Contact</a></li>\n<li><a href=\"elements.html\">Elements</a></li>\n<li>\n<a href=\"#\">Submenu</a>\n<ul>\n<li><a href=\"#\">Option One</a></li>\n<li><a href=\"#\">Option Two</a></li>\n<li><a href=\"#\">Option Three</a></li>\n<li><a href=\"#\">Option Four</a></li>\n</ul>\n</li>\n</ul>\n</li>\n<li><a class=\"button\" href=\"#\">Sign Up</a></li>\n</ul>\n</nav>\n</header>\n<!-- Main -->\n<section class=\"container medium\" id=\"main\">\n<header>\n<h2>Contact Us</h2>\n<p>Tell us what you think about our little operation.</p>\n</header>\n<div class=\"box\">\n<form action=\"#\" method=\"post\">\n<div class=\"row gtr-50 gtr-uniform\">\n<div class=\"col-6 col-12-mobilep\">\n<input id=\"name\" name=\"name\" placeholder=\"Name\" type=\"text\" value=\"\"/>\n</div>\n<div class=\"col-6 col-12-mobilep\">\n<input id=\"email\" name=\"email\" placeholder=\"Email\" type=\"email\" value=\"\"/>\n</div>\n<div class=\"col-12\">\n<input id=\"subject\" name=\"subject\" placeholder=\"Subject\" type=\"text\" value=\"\"/>\n</div>\n<div class=\"col-12\">\n<textarea id=\"message\" name=\"message\" placeholder=\"Enter your message\" rows=\"6\"></textarea>\n</div>\n<div class=\"col-12\">\n<ul class=\"actions special\">\n<li><input type=\"submit\" value=\"Send Message\"/></li>\n</ul>\n</div>\n</div>\n</form>\n</div>\n</section>\n<!-- Footer -->\n<footer id=\"footer\">\n<ul class=\"icons\">\n<li><a class=\"icon fa-twitter\" href=\"#\"><span class=\"label\">Twitter</span></a></li>\n<li><a class=\"icon fa-facebook\" href=\"#\"><span class=\"label\">Facebook</span></a></li>\n<li><a class=\"icon fa-instagram\" href=\"#\"><span class=\"label\">Instagram</span></a></l